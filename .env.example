# Copy to .env (or export in your shell). Never commit real values.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SHOP_BANK_DETAILS=Bank: Example Bank | Account name: Fruitboss | Account no: 0000000000
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Paystack secret key (sk_test_... while testing, sk_live_... in production). Leave empty to disable online payment.
PAYSTACK_SECRET_KEY=
