# Reference for /etc/fruitboss.env (setup.sh creates it with a generated secret key). Never commit real values.
DJANGO_SECRET_KEY=generated-by-setup
DJANGO_ALLOWED_HOSTS=fruitbossng.com,www.fruitbossng.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://fruitbossng.com,https://www.fruitbossng.com
DJANGO_DB_PATH=/srv/fruitboss/data/db.sqlite3
DJANGO_MEDIA_ROOT=/srv/fruitboss/media
# Paystack: sk_live_... for real payments. Empty hides "Pay online".
PAYSTACK_SECRET_KEY=
SHOP_BANK_DETAILS=Bank: ... | Account name: Fruitboss | Account no: ...
# Outgoing mail (Hetzner mail account). Empty = emails are only printed to the log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Fruitboss <info@fruitbossng.com>
